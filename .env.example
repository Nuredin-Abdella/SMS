# MESOB Telegram Bot Configuration
# Copy this file to .env and fill in your actual values

# Required
BOT_TOKEN=your_telegram_bot_token_here

# Optional
NODE_ENV=development
PORT=3000
ADMIN_CHAT_ID=your_admin_chat_id_for_admin_features

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/mesob_bot
REDIS_URI=redis://localhost:6379

# SMS Service Configuration
SMS_API_KEY=your_sms_api_key_here
SMS_API_URL=https://api.sms-provider.com/send

# Security
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/bot.log

# MESOB API Configuration
MESOB_API_URL=https://mesobshashe.gov.et/api
MESOB_API_KEY=your_mesob_api_key_here